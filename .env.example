# Copying this file to .env is optional: docker-compose.yml has the same
# development defaults. Every value here is a placeholder for local and CI use.

# Signs the session cookie. Never use this value in a deployment.
SESSION_SECRET=compose-dev-only-not-a-secret
# Postgres user, applied only when the pgdata volume is first created.
POSTGRES_USER=tennis
# Postgres password, applied only when the pgdata volume is first created.
POSTGRES_PASSWORD=tennis
# Postgres database name, created with the volume.
POSTGRES_DB=tennis
# Host port the app is published on.
APP_PORT=8000

# COOKIE_SECURE is deliberately not set: the stack is plain HTTP on localhost.
