{
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --stat -- *)",
      "Bash(git diff --cached)",
      "Bash(git diff --cached --stat)",
      "Bash(git diff --cached -- *)",
      "Bash(git diff --staged)",
      "Bash(git diff --staged --stat)",
      "Bash(git diff --staged -- *)",
      "Bash(git diff -- *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(make test-backend)",
      "Bash(uv run --directory backend pytest)",
      "Bash(uv run --directory backend pytest *)",
      "Bash(uv run --directory backend ruff *)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git config)",
      "Bash(git config *)",
      "Bash(git -c *)",
      "Bash(git -C *)",
      "Bash(git --git-dir*)",
      "Bash(git --work-tree*)",
      "Bash(git --config-env*)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git reflog)",
      "Bash(git reflog *)",
      "Bash(git cat-file *)",
      "Bash(git rev-list *)",
      "Bash(git grep *)",
      "Bash(git shortlog*)",
      "Bash(git whatchanged*)",
      "Bash(git ls-tree *)",
      "Bash(git archive *)",
      "Bash(git format-patch *)",
      "Bash(git diff *HEAD*)",
      "Bash(git diff *..*)",
      "Bash(git diff *~*)",
      "Bash(git diff *^*)",
      "Bash(git diff *@{*)",
      "Bash(git restore *)",
      "Bash(git checkout)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset)",
      "Bash(git reset *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(git stash)",
      "Bash(git stash *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git apply *)",
      "Bash(git am *)",
      "Bash(git tag *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git remote*)",
      "Bash(git clone *)",
      "Bash(git update-ref *)",
      "Bash(git symbolic-ref *)",
      "Bash(git notes *)",
      "Bash(git clean *)",
      "Bash(gh)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(socat *)",
      "Bash(telnet *)",
      "Bash(ftp *)",
      "Bash(rsync *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(podman *)",
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm -fr*)",
      "Bash(rm -fR*)",
      "Bash(rm * -r*)",
      "Bash(rm * -R*)",
      "Bash(sudo *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv lock*)",
      "Bash(uv sync*)",
      "Bash(uv pip *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(npm *)",
      "WebFetch",
      "WebSearch",
      "Edit(./.github/**)",
      "Edit(./agent-hooks/**)",
      "Edit(./.claude/**)",
      "Edit(./incident-response/**)",
      "Edit(./openapi.yaml)",
      "Edit(./Dockerfile)",
      "Edit(./docker-compose*.yml)",
      "Edit(./backend/pyproject.toml)",
      "Edit(./backend/uv.lock)",
      "Edit(./.git)",
      "Read(./incident-response/demo/**)",
      "Read(./agent-hooks/private-patterns.txt)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.gitconfig)",
      "Read(~/.config/git/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/agent-hooks/claude-pre-tool.sh"
          }
        ]
      }
    ]
  }
}
