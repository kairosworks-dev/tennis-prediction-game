# Copying this file to .env is optional: docker-compose.yml has the same
# development defaults. Every value here is a placeholder for local and CI use.

# Signs the session cookie. Never use this value in a deployment.
SESSION_SECRET=compose-dev-only-not-a-secret
# Postgres user, applied only when the pgdata volume is first created.
POSTGRES_USER=tennis
# Postgres password, applied only when the pgdata volume is first created.
POSTGRES_PASSWORD=tennis
# Postgres database name, created with the volume.
POSTGRES_DB=tennis
# Host port the app is published on.
APP_PORT=8000

# Where the verification email goes: `console` prints the address and token to
# the app's output; `discard` sends nothing and writes nothing. For local and CI
# use only. Unset means `discard`, and a deployed environment leaves it unset.
EMAIL_PROVIDER=console

# Whether the session cookie carries the Secure attribute. Accepted values:
# `true` and `false`; anything else stops start-up. The default is `false`,
# for plain-HTTP local use only. A deployment behind HTTPS sets `true`.
# Deliberately left out here: the dev stack is plain HTTP on localhost.
# COOKIE_SECURE=false
